<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <protected-broadcast android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
    <protected-broadcast android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
    <protected-broadcast android:name="org.unifiedpush.android.connector.UNREGISTERED" />
    <protected-broadcast android:name="org.unifiedpush.android.connector.MESSAGE" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Only granted to system apps. The server is only hosted by system apps (LightOS and the
         emulator), and LightClipboard checks the grant before using it. -->
    <uses-permission
        android:name="android.permission.SET_CLIP_SOURCE"
        tools:ignore="ProtectedPermissions" />
    <application>
        <receiver
            android:name=".LightPushDistributor"
            android:exported="true" >
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".installer.LightApkInstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".installer.LightApkUninstallResultReceiver"
            android:exported="false" />
        <service android:name=".toolmanager.ToolManagerLifecycleWrapperService"
            android:exported="false"/>
        <service
            android:name=".LightSdkService"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.thelightphone.sdk.action.BIND_SERVICE" />
            </intent-filter>
        </service>
    </application>

</manifest>